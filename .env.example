# HighWater environment variables (example, copy to .env.local)
# The MVP needs no API keys. These are optional, for stretch features only.

# Set to true only to send real SMS. Default is mock (writes data/outbox.json).
SEND_REAL_SMS=false

# Optional SMS sandbox provider keys (owner fills these in, never commit real values)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Optional Vercel deploy token (owner fills this in, never commit real value)
VERCEL_TOKEN=
