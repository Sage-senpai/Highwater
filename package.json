{
  "name": "highwater",
  "version": "0.1.0",
  "private": true,
  "description": "River-flood early warning for Nigerian primary health facilities",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "ingest:facilities": "tsx pipeline/ingest-facilities.ts",
    "pin:cells": "tsx pipeline/pin-cells.ts",
    "climatology": "tsx pipeline/climatology.ts",
    "refresh": "tsx pipeline/refresh.ts",
    "replay": "tsx pipeline/replay.ts",
    "alerts": "tsx pipeline/alerts.ts",
    "build:web-data": "tsx pipeline/build-web-data.ts"
  },
  "dependencies": {
    "fast-xml-parser": "4.5.3"
  },
  "devDependencies": {
    "tsx": "4.19.2",
